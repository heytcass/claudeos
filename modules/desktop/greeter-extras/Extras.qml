// Greeter extras — power actions and a last-boot health line.
//
// Only present when `claude-os.greeter.extras.enable` is on; then
// modules/desktop/greeter.nix copies this file next to shell.qml and applies
// shell.patch (beside this file), which adds ONE Loader pointing here.
//
// This directory is deliberately NOT modules/desktop/greeter/: that directory
// is interpolated into the stable greeter's derivation, so adding a file to it
// would change the login screen of every host, including ones that have not
// opted in to the extras.
//
// WHY A LOADER AND NOT INLINE. shell.qml is the login path: if it fails to
// load there is no password field. Everything in this file is optional, so it
// is loaded dynamically — a mistake here leaves the Loader empty (status
// Error, logged) and the clock, card and greetd wiring in shell.qml untouched.
// That isolation was checked, not assumed (2026-11-05, quickshell 0.3.2): with
// a syntax error or a missing import in this file, quickshell logs a `scene`
// warning for Extras.qml and still reports "Configuration Loaded".
//
// Nothing here reads the user's home or any secret. The greeter runs as the
// `greeter` system user before a session exists; both features go through
// systemd only:
//   - power: `systemctl poweroff|reboot`, allowed for the active local
//     session by logind's default polkit rules — the same path the bar's
//     PowerWidget and regreet's own buttons use.
//   - health: `systemctl list-units --state=failed`, read-only.
// Absolute command paths come from GreeterConfig (generated by Nix): the
// greeter's PATH is not something to rely on.

import QtQuick
import Quickshell
import Quickshell.Io

Item {
    id: extras

    // ---- last-boot health ------------------------------------------------
    // -1 = not known yet (line hidden). Counted from one unit per line.
    property int failedUnits: -1

    Process {
        id: healthProbe
        command: GreeterConfig.failedUnitsCommand
        stdout: StdioCollector {
            onStreamFinished: {
                var n = 0;
                var lines = this.text.split("\n");
                for (var i = 0; i < lines.length; i++) {
                    if (lines[i].trim() !== "")
                        n++;
                }
                extras.failedUnits = n;
            }
        }
    }

    // Boot may still be settling when the greeter appears, so re-check rather
    // than trusting the first answer for as long as the screen sits there.
    Timer {
        interval: 30000
        running: true
        repeat: true
        triggeredOnStart: true
        onTriggered: {
            if (!healthProbe.running)
                healthProbe.running = true;
        }
    }

    Text {
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        anchors.bottomMargin: 28
        visible: extras.failedUnits >= 0
        text: extras.failedUnits === 0 ? "All system units healthy" : extras.failedUnits === 1 ? "1 system unit failed this boot" : extras.failedUnits + " system units failed this boot"
        color: extras.failedUnits > 0 ? Theme.warn : Theme.muted
        font.family: Theme.fontSans
        font.pixelSize: Theme.fontSize - 1
    }

    // ---- power -----------------------------------------------------------
    // Two taps to commit, like the bar's PowerWidget: the first arms the
    // button (label turns into a question, in the urgent colour), the second
    // within a few seconds runs it. A stray click on a login screen must not
    // power the machine off.
    Row {
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        anchors.rightMargin: 28
        anchors.bottomMargin: 20
        spacing: Theme.gap

        Repeater {
            model: [
                {
                    label: "Restart",
                    confirm: "Restart?",
                    cmd: GreeterConfig.rebootCommand
                },
                {
                    label: "Shut down",
                    confirm: "Shut down?",
                    cmd: GreeterConfig.poweroffCommand
                }
            ]

            delegate: Rectangle {
                id: btn
                required property var modelData
                property bool armed: false

                width: btnText.implicitWidth + 28
                height: 32
                radius: Theme.radius
                color: btnArea.containsMouse || btn.armed ? Qt.rgba(Theme.surface.r, Theme.surface.g, Theme.surface.b, 0.85) : Qt.rgba(Theme.bg.r, Theme.bg.g, Theme.bg.b, 0.6)
                border.width: 1
                border.color: btn.armed ? Theme.urgent : Qt.rgba(Theme.muted.r, Theme.muted.g, Theme.muted.b, 0.4)

                Text {
                    id: btnText
                    anchors.centerIn: parent
                    text: btn.armed ? btn.modelData.confirm : btn.modelData.label
                    color: btn.armed ? Theme.urgent : Theme.subtext
                    font.family: Theme.fontSans
                    font.pixelSize: Theme.fontSize - 1
                }

                Timer {
                    id: disarm
                    interval: 4000
                    onTriggered: btn.armed = false
                }

                MouseArea {
                    id: btnArea
                    anchors.fill: parent
                    hoverEnabled: true
                    onClicked: {
                        if (!btn.armed) {
                            btn.armed = true;
                            disarm.restart();
                            return;
                        }
                        btn.armed = false;
                        Quickshell.execDetached(btn.modelData.cmd);
                    }
                }
            }
        }
    }
}
