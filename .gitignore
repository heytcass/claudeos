# Nix build results
result
result-*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Secrets (unencrypted)
secrets/*.key
secrets/*.age
!secrets/.sops.yaml
!secrets/secrets.yaml

# Machine-local Claude Code settings (session-scratch allowlist; accretes
# one-off commands and machine paths — durable rules live in settings.json)
.claude/settings.local.json
# Claude Code writes settings.local.json.tmp.<pid>.<hash> while saving; a
# `git add -A` mid-write will otherwise commit one (it did, once).
.claude/settings.local.json.tmp.*

# Temporary files
*.tmp
*.bak

# Git worktrees
.worktrees/
